        "import pandas as pd"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Supervised Learning Dataset\n",
        "\n",
        "customers = pd.DataFrame({\n",
        "    \"Tenure\": [2, 24, 3, 36],\n",
        "    \"MonthlyBill\": [900, 500, 1000, 450],\n",
        "    \"Churn\": [\"Yes\", \"No\", \"Yes\", \"No\"]\n", # Target is given
        "})\n",
        "\n",
        "print(customers)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "xU1cNPyJmglb",
