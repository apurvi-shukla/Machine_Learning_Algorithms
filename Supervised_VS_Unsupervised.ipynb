            "   Tenure  MonthlyBill Churn\n",
            "0       2          900   Yes\n",
            "1      24          500    No\n",
            "2       3         1000   Yes\n",
            "3      36          450    No\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Unsupervised Learning Dataset\n",
        "\n",
        "customer_data = customers[[\"Tenure\", \"MonthlyBill\"]]\n",
        "\n",
        "print(customer_data)"
